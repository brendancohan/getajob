# Registers a daily 2:00 AM Windows Scheduled Task for the Job Search Pipeline.
# Update $ScriptPath to the location of your run-job-pipeline.ps1 copy.

$TaskName = "JobSearchPipeline"
$ScriptPath = "C:\path\to\your\job-search-workspace\run-job-pipeline.ps1"

$Action = New-ScheduledTaskAction `
    -Execute "powershell.exe" `
    -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$ScriptPath`""

$Trigger = New-ScheduledTaskTrigger -Daily -At 2:00AM

$Settings = New-ScheduledTaskSettingsSet `
    -StartWhenAvailable `
    -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries

Register-ScheduledTask `
    -TaskName $TaskName `
    -Action $Action `
    -Trigger $Trigger `
    -Settings $Settings `
    -Description "Nightly automated job scraping and AI triage pipeline" `
    -Force

Write-Output "Registered scheduled task '$TaskName' to run daily at 2:00 AM."
